@model IPagedList<Sal_Fuego.Aplication.DTOs.ComboDTO>

@{
    ViewData["Title"] = "Gestión de Combos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Gestión de Combos</h1>
        <a asp-controller="AdminCombo" asp-action="Agregar"
           class="btn btn-success">
            + Agregar Combo
        </a>
    </div>

    <!-- Filtros -->
    <form method="get" class="row g-2 mb-4">
        <div class="col-md-4">
            <select name="categoriaId" class="form-select"
                    onchange="this.form.submit()">
                <option value="">-- Todas las categorías --</option>
                @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.Categorias)
                {
                    @if (item.Selected)
                    {
                        <option value="@item.Value" selected>@item.Text</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-5">
            <div class="input-group">
                <input type="text" name="busqueda" class="form-control"
                       placeholder="Buscar por nombre..."
                       value="@ViewBag.Busqueda" />
                <button type="submit" class="btn btn-outline-secondary">Buscar</button>
            </div>
        </div>
        <div class="col-md-3">
            <a asp-controller="AdminCombo" asp-action="Index"
               class="btn btn-outline-secondary w-100">
                Limpiar filtros
            </a>
        </div>
    </form>

    <!-- Tabla -->
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Imagen</th>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Precio Especial</th>
                <th>Productos</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="@item.UrlImagen"
                             alt="@item.Nombre"
                             style="width:60px; height:60px;
                        object-fit:cover; border-radius:6px;">
                    </td>
                    <td>@item.Nombre</td>
                    <td>@item.CategoriaNombre</td>
                    <td>₡@item.PrecioEspecial.ToString("N2")</td>
                    <td>
                        <span class="badge bg-primary">
                            @item.Productos.Count producto(s)
                        </span>
                    </td>
                    <td>
                        @if (item.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="AdminCombo"
                           asp-action="Editar"
                           asp-route-id="@item.IdCombo"
                           class="btn btn-sm btn-outline-warning">
                            Editar
                        </a>
                        <form asp-controller="AdminCombo"
                              asp-action="Desactivar"
                              method="post" class="d-inline"
                              onsubmit="return confirmarAccion(event, item.Activo ? '¿Desactivar este combo?' : '¿Activar este combo?')">
                            <input type="hidden" name="id" value="@item.IdCombo" />
                            @Html.AntiForgeryToken()

                            @if (item.Activo)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Desactivar
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-success">
                                    Activar
                                </button>
                            }
                        </form>

                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.PageCount > 1)
    {
        <div class="d-flex justify-content-center mt-4">
            @Html.PagedListPager((IPagedList)Model,
                page => Url.Action("Index", new { page, categoriaId = ViewBag.CategoriaSeleccionada, busqueda = ViewBag.Busqueda }),
                new PagedListRenderOptions
                {
                    LiElementClasses = new[] { "page-item" },
                    PageClasses = new[] { "page-link" }
                })
        </div>
    }
</div>