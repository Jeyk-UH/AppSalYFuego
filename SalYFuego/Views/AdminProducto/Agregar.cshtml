@model Sal_Fuego.Aplication.DTOs.ProductoFormDTO

@{
    ViewData["Title"] = "Agregar Producto";
    var todosIngredientes = ViewBag.TodosIngredientes as IEnumerable<Sal_Fuego.Aplication.DTOs.IngredienteDTO>;
    var seleccionados = ViewBag.IngredientesSeleccionados as List<int> ?? new List<int>();
}

<div class="container mt-4" style="max-width: 800px;">
    <h2>Agregar Producto</h2>
    <hr />

    <form asp-action="Agregar" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <!-- Nombre -->
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>

        <!-- Descripción -->
        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label">Descripción</label>
            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger small"></span>
        </div>

        <!-- Precio y Categoría -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Precio" class="form-label">Precio (₡)</label>
                <input asp-for="Precio" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Precio" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="IdCategoria" class="form-label">Categoría</label>
                <select asp-for="IdCategoria" asp-items="ViewBag.Categorias"
                        class="form-select">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="IdCategoria" class="text-danger small"></span>
            </div>
        </div>

        <!-- Activo -->
        <div class="mb-3 form-check">
            <input asp-for="Activo" class="form-check-input" type="checkbox" />
            <label asp-for="Activo" class="form-check-label">Producto activo</label>
        </div>

        <!-- Imagen -->
        <div class="mb-4">
            <label asp-for="ImagenFile" class="form-label">Imagen del producto</label>
            <input asp-for="ImagenFile" class="form-control" type="file"
                   accept="image/*" onchange="previewImagen(this)" />
            <img id="preview" src="#" alt="Preview"
                 class="mt-2 d-none"
                 style="height:120px; border-radius:8px; object-fit:cover;">
        </div>

        <!-- Selector de Ingredientes -->
        <div class="mb-4">
            <label class="form-label fw-bold">Ingredientes</label>

            <div class="border rounded p-3">
                <!-- Buscador -->
                <input type="text" id="buscadorIngrediente"
                       class="form-control mb-3"
                       placeholder="Buscar ingrediente..."
                       onkeyup="filtrarIngredientes()" />

                <!-- Grid de ingredientes disponibles -->
                <div class="row g-2" id="gridIngredientes">
                    @if (todosIngredientes != null)
                    {
                        @foreach (var ing in todosIngredientes)
                        {
                            <div class="col-md-4 ingrediente-item"
                                 data-nombre="@ing.Nombre.ToLower()">
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm w-100 text-start"
                                        onclick="agregarIngrediente(@ing.IdIngrediente, '@ing.Nombre')">
                                    + @ing.Nombre
                                </button>
                            </div>
                        }
                    }
                </div>

                <hr />

                <!-- Ingredientes seleccionados como chips -->
                <p class="text-muted small mb-2">Ingredientes seleccionados:</p>
                <div id="ingredientesSeleccionados" class="d-flex flex-wrap gap-2 min-height-chips">
                    <!-- Se agregan dinámicamente -->
                </div>

                <!-- Inputs hidden para enviar al servidor -->
                <div id="inputsIngredientes"></div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Preview de imagen
        function previewImagen(input) {
            const preview = document.getElementById('preview');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Filtrar ingredientes por nombre
        function filtrarIngredientes() {
            const busqueda = document.getElementById('buscadorIngrediente').value.toLowerCase();
            document.querySelectorAll('.ingrediente-item').forEach(item => {
                item.style.display = item.dataset.nombre.includes(busqueda) ? '' : 'none';
            });
        }

        // Ingredientes ya seleccionados (para editar)
        const seleccionados = new Set(@Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(seleccionados)));

        // Al cargar, mostrar los ya seleccionados
        document.addEventListener('DOMContentLoaded', () => {
            seleccionados.forEach(id => {
                const btn = document.querySelector(`button[onclick*="agregarIngrediente(${id},"]`);
                if (btn) {
                    const nombre = btn.textContent.trim().substring(2);
                    agregarIngrediente(id, nombre);
                }
            });
        });

        function agregarIngrediente(id, nombre) {
            if (seleccionados.has(id)) return;
            seleccionados.add(id);

            // Crear chip
            const chip = document.createElement('div');
            chip.className = 'badge d-flex align-items-center gap-1 p-2';
            chip.style.cssText = 'background-color:#f5a623; color:#1a1a1a; font-size:0.85rem;';
            chip.id = `chip-${id}`;
            chip.innerHTML = `
                ${nombre}
                <span style="cursor:pointer; font-size:1rem;"
                      onclick="quitarIngrediente(${id})">&times;</span>`;

            document.getElementById('ingredientesSeleccionados').appendChild(chip);

            // Crear input hidden
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'IngredientesSeleccionados';
            input.value = id;
            input.id = `input-${id}`;
            document.getElementById('inputsIngredientes').appendChild(input);
        }

        function quitarIngrediente(id) {
            seleccionados.delete(id);
            document.getElementById(`chip-${id}`)?.remove();
            document.getElementById(`input-${id}`)?.remove();
        }
    </script>
}