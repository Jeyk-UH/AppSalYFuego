@model Sal_Fuego.Aplication.DTOs.ProductoDTO
@using Sal_Fuego.Aplication.Config
@using System.Globalization

@{
    bool esCliente = User.IsInRole(Roles.Cliente);
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <img src="@Model.ImagenUrl" class="img-fluid rounded shadow" alt="@Model.Nombre">
        </div>

        <div class="col-md-6">
            <h1 class="text-primary">@Model.Nombre</h1>
            <p class="lead">@Model.Descripcion</p>
            <h3 class="text-success">₡@Model.Precio</h3>

            <hr />

            <h5>Ingredientes:</h5>
            <ul class="list-group list-group-flush mb-4">
                @foreach (var ing in Model.Ingredientes)
                {
                    <li class="list-group-item">@ing.Nombre</li>
                }
            </ul>

            @if (esCliente)
            {
                <div class="d-flex align-items-center gap-2 mb-3"
                     data-carrito-tipo="Producto" data-carrito-id="@Model.IdProducto"
                     data-carrito-nombre="@Model.Nombre" data-carrito-precio="@Model.Precio.ToString(CultureInfo.InvariantCulture)">
                    <input type="number" min="1" value="1" class="form-control input-cantidad-agregar" style="width:90px;">
                    <button type="button" class="btn btn-agregar-carrito flex-grow-1"
                            style="background-color:#f5a623; color:#1a1a1a; font-weight:bold;">
                        Agregar al carrito
                    </button>
                </div>
            }

            <a asp-action="Index" class="btn btn-secondary">Volver al catálogo</a>
        </div>
    </div>
</div>