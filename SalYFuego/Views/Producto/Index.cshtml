@model IEnumerable<Sal_Fuego.Aplication.DTOs.ProductoDTO>

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="container mt-4">
    <h1>Nuestros Productos</h1>
    <hr />

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 product-card">
                        <img src="@item.ImagenUrl" class="card-img-top" alt="@item.Nombre">
                        <div class="card-body">
                            <h5 class="card-title text-primary">@item.Nombre</h5>
                            <p class="card-text">@item.Descripcion</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="h5">₡@item.Precio.ToString("N2")</span>
                                <a asp-action="Detalle" asp-route-id="@item.IdProducto" class="btn btn-outline-primary">Ver detalle</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p>No hay productos disponibles en este momento.</p>
    }
</div>
