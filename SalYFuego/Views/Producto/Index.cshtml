@model IPagedList<Sal_Fuego.Aplication.DTOs.ProductoDTO>
@using Sal_Fuego.Aplication.Config
@using System.Globalization

@{
    ViewData["Title"] = "Catálogo de Productos";
    bool esCliente = User.IsInRole(Roles.Cliente);
}

<div class="container mt-4">
    <h1>Nuestros Productos</h1>
    <hr />

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 product-card">
                        <img src="@item.ImagenUrl" class="card-img-top" alt="@item.Nombre">
                        <div class="card-body">
                            <h5 class="card-title text-primary">@item.Nombre</h5>
                            <p class="card-text">@item.Descripcion</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="h5">₡@item.Precio.ToString("N2")</span>
                                <a asp-action="Detalle" asp-route-id="@item.IdProducto" class="btn btn-outline-primary">Ver detalle</a>
                            </div>
                            @if (esCliente)
                            {
                                <div class="d-flex align-items-center gap-2 mt-2"
                                     data-carrito-tipo="Producto" data-carrito-id="@item.IdProducto"
                                     data-carrito-nombre="@item.Nombre" data-carrito-precio="@item.Precio.ToString(CultureInfo.InvariantCulture)">
                                    <input type="number" min="1" value="1" class="form-control form-control-sm input-cantidad-agregar" style="width:70px;">
                                    <button type="button" class="btn btn-sm btn-agregar-carrito flex-grow-1"
                                            style="background-color:#f5a623; color:#1a1a1a; font-weight:bold;">
                                        Agregar
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.PageCount > 1)
        {
            <div class="d-flex justify-content-center mt-4">
                @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page }),
                    new PagedListRenderOptions
                    {
                        LiElementClasses = new[] { "page-item" },
                        PageClasses = new[] { "page-link" }
                    })
            </div>
        }
    }
    else
    {
        <p>No hay productos disponibles en este momento.</p>
    }
</div>
