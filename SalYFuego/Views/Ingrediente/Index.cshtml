@model IEnumerable<Sal_Fuego.Aplication.DTOs.IngredienteDTO>

@{
    ViewData["Title"] = "Ingredientes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Ingredientes</h1>
        <a asp-action="Agregar" class="btn btn-success">
            + Agregar Ingrediente
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Nombre</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdIngrediente</td>
                    <td>@item.Nombre</td>
                    <td>
                        <a asp-action="Editar"
                           asp-route-id="@item.IdIngrediente"
                           class="btn btn-sm btn-outline-warning">
                            Editar
                        </a>
                        <form asp-action="Eliminar" method="post" class="d-inline"
                              onsubmit="return confirm('¿Estás seguro de eliminar este ingrediente?')">
                            <input type="hidden" name="id" value="@item.IdIngrediente" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>