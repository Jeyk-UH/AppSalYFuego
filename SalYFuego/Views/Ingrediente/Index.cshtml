@model IPagedList<Sal_Fuego.Aplication.DTOs.IngredienteDTO>

@{
    ViewData["Title"] = "Ingredientes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Ingredientes</h1>
        <a asp-action="Agregar" class="btn btn-success">
            + Agregar Ingrediente
        </a>
    </div>

    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Nombre</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdIngrediente</td>
                    <td>@item.Nombre</td>
                    <td>
                        <a asp-action="Editar"
                           asp-route-id="@item.IdIngrediente"
                           class="btn btn-sm btn-outline-warning">
                            Editar
                        </a>
                        <form asp-action="Eliminar" method="post" class="d-inline"
                              onsubmit="return confirmarAccion(event, '¿Estás seguro de eliminar este ingrediente?')">
                            <input type="hidden" name="id" value="@item.IdIngrediente" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.PageCount > 1)
    {
        <div class="d-flex justify-content-center mt-4">
            @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page }),
                new PagedListRenderOptions
                {
                    LiElementClasses = new[] { "page-item" },
                    PageClasses = new[] { "page-link" }
                })
        </div>
    }
</div>