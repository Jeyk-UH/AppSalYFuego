@model Sal_Fuego.Aplication.DTOs.ReporteVentasDTO

@{
    ViewData["Title"] = "Reportes";

    var etiquetasDiasJson = System.Text.Json.JsonSerializer.Serialize(Model.PedidosPorDia.Select(p => p.Etiqueta));
    var cantidadesDiasJson = System.Text.Json.JsonSerializer.Serialize(Model.PedidosPorDia.Select(p => p.Cantidad));

    var nombresMasVendidosJson = System.Text.Json.JsonSerializer.Serialize(Model.MasVendidos.Select(i => $"{i.Nombre} ({i.Tipo})"));
    var cantidadesMasVendidosJson = System.Text.Json.JsonSerializer.Serialize(Model.MasVendidos.Select(i => i.CantidadVendida));

    var nombresMenosVendidosJson = System.Text.Json.JsonSerializer.Serialize(Model.MenosVendidos.Select(i => $"{i.Nombre} ({i.Tipo})"));
    var cantidadesMenosVendidosJson = System.Text.Json.JsonSerializer.Serialize(Model.MenosVendidos.Select(i => i.CantidadVendida));
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1>Reportes</h1>
            <p class="text-muted mb-0">Información consolidada de ventas y pedidos</p>
        </div>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>

    <form asp-controller="Admin" asp-action="Reportes" method="get" class="row g-2 align-items-end mb-4">
        <div class="col-auto">
            <label class="form-label small mb-1">Desde</label>
            <input type="date" name="desde" class="form-control" value="@Model.Desde.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-auto">
            <label class="form-label small mb-1">Hasta</label>
            <input type="date" name="hasta" class="form-control" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn" style="background-color:#f5a623; color:#1a1a1a; font-weight:bold;">
                Filtrar
            </button>
        </div>
    </form>

    <div class="row g-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small mb-3">Pedidos por Día</h6>
                    <canvas id="graficoPedidosPorDia" height="90"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small mb-3">Productos y Combos Más Vendidos</h6>
                    @if (Model.MasVendidos.Any())
                    {
                        <canvas id="graficoMasVendidos"></canvas>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Aún no hay ventas registradas.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small mb-3">Productos y Combos Menos Vendidos</h6>
                    @if (Model.MenosVendidos.Any())
                    {
                        <canvas id="graficoMenosVendidos"></canvas>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Aún no hay ventas registradas.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        // Gráfico 1: cantidad de pedidos por día, dentro del rango filtrado.
        const etiquetasDias = @Html.Raw(etiquetasDiasJson);
        const cantidadesDias = @Html.Raw(cantidadesDiasJson);

        new Chart(document.getElementById('graficoPedidosPorDia'), {
            type: 'bar',
            data: {
                labels: etiquetasDias,
                datasets: [{
                    label: 'Pedidos',
                    data: cantidadesDias,
                    backgroundColor: '#f5a623'
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });

        // Gráfico 2: ranking de productos/combos más vendidos (barras horizontales).
        const nombresMasVendidos = @Html.Raw(nombresMasVendidosJson);
        const cantidadesMasVendidos = @Html.Raw(cantidadesMasVendidosJson);

        if (nombresMasVendidos.length > 0) {
            new Chart(document.getElementById('graficoMasVendidos'), {
                type: 'bar',
                data: {
                    labels: nombresMasVendidos,
                    datasets: [{
                        label: 'Cantidad vendida',
                        data: cantidadesMasVendidos,
                        backgroundColor: '#28a745'
                    }]
                },
                options: {
                    indexAxis: 'y',
                    plugins: { legend: { display: false } },
                    scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });
        }

        // Gráfico 3: los productos/combos con menos ventas (mismo tipo de gráfico).
        const nombresMenosVendidos = @Html.Raw(nombresMenosVendidosJson);
        const cantidadesMenosVendidos = @Html.Raw(cantidadesMenosVendidosJson);

        if (nombresMenosVendidos.length > 0) {
            new Chart(document.getElementById('graficoMenosVendidos'), {
                type: 'bar',
                data: {
                    labels: nombresMenosVendidos,
                    datasets: [{
                        label: 'Cantidad vendida',
                        data: cantidadesMenosVendidos,
                        backgroundColor: '#dc3545'
                    }]
                },
                options: {
                    indexAxis: 'y',
                    plugins: { legend: { display: false } },
                    scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });
        }
    </script>
}
