@model Sal_Fuego.Aplication.DTOs.ComboDTO
@using Sal_Fuego.Aplication.Config
@using System.Globalization

@{
    ViewData["Title"] = Model.Nombre;
    bool esCliente = User.IsInRole(Roles.Cliente);
}

<div class="container mt-4">
    <a asp-controller="Combo" asp-action="Index" class="btn btn-secondary mb-3">
        ← Volver a Combos
    </a>

    <div class="row">
        <div class="col-md-5">
            <img src="@Model.UrlImagen"
                 class="img-fluid rounded"
                 alt="@Model.Nombre">
        </div>
        <div class="col-md-7">
            <h2>@Model.Nombre</h2>
            <p class="text-muted">@Model.CategoriaNombre</p>
            <p>@Model.Descripcion</p>
            <h4 class="text-success">₡@Model.PrecioEspecial</h4>

            @if (esCliente)
            {
                <div class="d-flex align-items-center gap-2 mb-3"
                     data-carrito-tipo="Combo" data-carrito-id="@Model.IdCombo"
                     data-carrito-nombre="@Model.Nombre" data-carrito-precio="@Model.PrecioEspecial.ToString(CultureInfo.InvariantCulture)">
                    <input type="number" min="1" value="1" class="form-control input-cantidad-agregar" style="width:90px;">
                    <button type="button" class="btn btn-agregar-carrito flex-grow-1"
                            style="background-color:#f5a623; color:#1a1a1a; font-weight:bold;">
                        Agregar al carrito
                    </button>
                </div>
            }

            <hr />
            <h5>Productos incluidos:</h5>
            <ul class="list-group">
                @foreach (var producto in Model.Productos)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@producto.NombreProducto</span>
                        <span class="badge bg-primary">x @(producto.Cantidad)</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>