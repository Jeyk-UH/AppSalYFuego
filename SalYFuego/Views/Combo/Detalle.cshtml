@model Sal_Fuego.Aplication.DTOs.ComboDTO

@{
    ViewData["Title"] = Model.Nombre;
}

<div class="container mt-4">
    <a asp-controller="Combo" asp-action="Index" class="btn btn-secondary mb-3">
        ← Volver a Combos
    </a>

    <div class="row">
        <div class="col-md-5">
            <img src="@Model.UrlImagen"
                 class="img-fluid rounded"
                 alt="@Model.Nombre">
        </div>
        <div class="col-md-7">
            <h2>@Model.Nombre</h2>
            <p class="text-muted">@Model.CategoriaNombre</p>
            <p>@Model.Descripcion</p>
            <h4 class="text-success">₡@Model.PrecioEspecial</h4>

            <hr />
            <h5>Productos incluidos:</h5>
            <ul class="list-group">
                @foreach (var producto in Model.Productos)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@producto.NombreProducto</span>
                        <span class="badge bg-primary">x @(producto.Cantidad)</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>