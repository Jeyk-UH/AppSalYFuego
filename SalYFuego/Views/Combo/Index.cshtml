@model IPagedList<Sal_Fuego.Aplication.DTOs.ComboDTO>
@using Sal_Fuego.Aplication.Config
@using System.Globalization

@{
    ViewData["Title"] = "Catálogo de Combos";
    bool esCliente = User.IsInRole(Roles.Cliente);
}

<div class="container mt-4">
    <h1>Nuestros Combos</h1>
    <hr />

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 product-card">
                        <img src="@item.UrlImagen"
                             class="card-img-top"
                             alt="@item.Nombre"
                             style="height: 180px; object-fit: cover;">
                        <div class="card-body">
                            <h5 class="card-title text-primary">@item.Nombre</h5>
                            <p class="text-muted small">@item.CategoriaNombre</p>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="h5">₡@item.PrecioEspecial.ToString("N2")</span>
                                <a asp-controller="Combo"
                                   asp-action="Detalle"
                                   asp-route-id="@item.IdCombo"
                                   class="btn btn-outline-primary btn-sm">
                                    Ver detalle
                                </a>
                            </div>
                            @if (esCliente)
                            {
                                <div class="d-flex align-items-center gap-2 mt-2"
                                     data-carrito-tipo="Combo" data-carrito-id="@item.IdCombo"
                                     data-carrito-nombre="@item.Nombre" data-carrito-precio="@item.PrecioEspecial.ToString(CultureInfo.InvariantCulture)">
                                    <input type="number" min="1" value="1" class="form-control form-control-sm input-cantidad-agregar" style="width:70px;">
                                    <button type="button" class="btn btn-sm btn-agregar-carrito flex-grow-1"
                                            style="background-color:#f5a623; color:#1a1a1a; font-weight:bold;">
                                        Agregar
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.PageCount > 1)
        {
            <div class="d-flex justify-content-center mt-4">
                @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page }),
                    new PagedListRenderOptions
                    {
                        LiElementClasses = new[] { "page-item" },
                        PageClasses = new[] { "page-link" }
                    })
            </div>
        }
    }
    else
    {
        <p>No hay combos disponibles en este momento.</p>
    }
</div>