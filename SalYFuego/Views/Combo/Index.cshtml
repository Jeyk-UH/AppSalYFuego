@model IEnumerable<Sal_Fuego.Aplication.DTOs.ComboDTO>

@{
    ViewData["Title"] = "Catálogo de Combos";
}

<div class="container mt-4">
    <h1>Nuestros Combos</h1>
    <hr />

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100">
                        <img src="@item.UrlImagen"
                             class="card-img-top"
                             alt="@item.Nombre"
                             style="height: 180px; object-fit: cover;">
                        <div class="card-body">
                            <h5 class="card-title text-primary">@item.Nombre</h5>
                            <p class="text-muted small">@item.CategoriaNombre</p>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="h5">₡@item.PrecioEspecial</span>
                                <a asp-controller="Combo"
                                   asp-action="Detalle"
                                   asp-route-id="@item.IdCombo"
                                   class="btn btn-outline-primary btn-sm">
                                    Ver detalle
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p>No hay combos disponibles en este momento.</p>
    }
</div>