@model ICollection<Sal_Fuego.Aplication.DTOs.MenuItemDTO>
@using System.Security.Claims
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf

@{
    ViewData["Title"] = "Mi Carrito";

    var catalogoJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Select(m => new
        {
            tipo = m.Tipo,
            id = m.Tipo == "Producto" ? m.IdProducto : m.IdCombo,
            nombre = m.Nombre,
            precio = m.Precio,
            imagen = m.ImagenUrl,
            categoria = m.CategoriaNombre
        }));

    var csrfToken = Xsrf.GetAndStoreTokens(Context).RequestToken;

    var metodosPagoJson = System.Text.Json.JsonSerializer.Serialize(
        ((ICollection<Sal_Fuego.Aplication.DTOs.MetodoPagoDTO>)ViewBag.MetodosPago)
            .Select(m => new { id = m.IdMetodoPago, nombre = m.Nombre }));

    decimal costoEnvioDomicilio = ViewBag.CostoEnvioDomicilio;
    var correoCliente = User.FindFirstValue(ClaimTypes.Email);
    var clima = ViewBag.Clima as Sal_Fuego.Aplication.DTOs.ClimaDTO;
}

<style>
    .catalogo-card,
    .btn,
    .list-group-item {
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
    }

    .catalogo-card {
        user-select: none;
        transition: transform 0.08s ease, box-shadow 0.08s ease;
    }

    .catalogo-card:active {
        transform: scale(0.96);
        box-shadow: 0 0 0 3px #f5a623 inset;
    }

    .btn-touch {
        width: 44px;
        height: 44px;
        font-size: 1.2rem;
        line-height: 1;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .input-cantidad {
        touch-action: manipulation;
    }

    #btnConfirmarPedido {
        min-height: 60px;
        font-size: 1.2rem;
    }

    .btn-categoria {
        border: 1px solid #f5a623;
        background-color: #fff;
        color: #1a1a1a;
        border-radius: 20px;
        padding: 6px 16px;
        font-size: 0.9rem;
    }

    .btn-categoria.active {
        background-color: #f5a623;
        color: #1a1a1a;
        font-weight: bold;
    }

    /* Pestañas Catálogo / Mi pedido, solo en móvil (ver d-lg-none) */
    .tab-movil {
        border: 1px solid #f5a623;
        background-color: #fff;
        color: #1a1a1a;
        font-weight: 600;
    }

    .tab-movil.active {
        background-color: #f5a623;
        color: #1a1a1a;
    }

    .tab-movil .badge {
        color: #fff;
    }

    .tab-movil.active .badge {
        background-color: #1a1a1a !important;
    }
</style>

<div class="container-fluid mt-4">
    <h1 class="mb-3">Mi Carrito</h1>

    <!-- Pestañas Catálogo / Mi pedido: solo en móvil, para no obligar a hacer
         scroll por todo el catálogo antes de llegar al resumen del pedido. -->
    <div id="tabsMovil" class="d-lg-none d-flex gap-2 mb-3">
        <button type="button" id="btnTabCatalogo" class="btn flex-fill tab-movil active">Catálogo</button>
        <button type="button" id="btnTabPedido" class="btn flex-fill tab-movil">
            Mi pedido <span id="badgeTabPedido" class="badge rounded-pill" style="background:#6c757d;">0</span>
        </button>
    </div>

    <div class="row g-3">
        <!-- Catálogo -->
        <div class="col-lg-8" id="colCatalogo">
            <input type="text" id="inputBuscarProducto" class="form-control mb-3"
                   placeholder="Buscar producto o combo...">

            @if (!Model.Any())
            {
                <p class="text-muted">No hay productos ni combos disponibles en el menú en este momento.</p>
            }
            else
            {
                <div id="categoriasFiltro" class="d-flex flex-wrap gap-2 mb-3"></div>
                <div class="row g-3" id="catalogoGrid"></div>
            }
        </div>

        <!-- Carrito / Confirmación -->
        <div class="col-lg-4" id="colPedido">
            <div class="card shadow-sm" style="position: sticky; top: 1rem;">
                <div class="card-body">
                    <h5 class="mb-1">Mi pedido</h5>
                    <p class="small text-muted mb-1">
                        Cliente: <strong>@User.Identity!.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(correoCliente))
                        {
                            <text> &middot; @correoCliente</text>
                        }
                    </p>
                    <p class="small text-muted mb-3">
                        Estado: <strong>Pendiente de Pago</strong>
                    </p>

                    @if (clima != null)
                    {
                        <div class="alert alert-light border small py-2 mb-3">
                            Clima actual: <strong>@clima.TemperaturaC.ToString("N0")&deg;C</strong>, @clima.Descripcion.
                            El tiempo de entrega a domicilio puede variar según el clima.
                        </div>
                    }

                    <!-- Método de entrega -->
                    <div class="mb-3">
                        <label class="form-label small mb-1">Método de entrega</label>
                        <select id="selectMetodoEntrega" class="form-select form-select-sm">
                            <option value="Recogida en tienda">Recogida en tienda</option>
                            <option value="Entrega a domicilio">Entrega a domicilio (+₡@costoEnvioDomicilio.ToString("N2"))</option>
                        </select>
                    </div>

                    <!-- Dirección (solo si es a domicilio) -->
                    <div id="panelDireccion" class="mb-3" style="display:none;">
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="text" id="inputProvincia" class="form-control form-control-sm" placeholder="Provincia">
                            </div>
                            <div class="col-6">
                                <input type="text" id="inputCanton" class="form-control form-control-sm" placeholder="Cantón">
                            </div>
                            <div class="col-6">
                                <input type="text" id="inputDistrito" class="form-control form-control-sm" placeholder="Distrito">
                            </div>
                            <div class="col-12">
                                <input type="text" id="inputDireccionExacta" class="form-control form-control-sm mt-2" placeholder="Dirección exacta (obligatoria)">
                            </div>
                            <div class="col-12">
                                <input type="text" id="inputReferencia" class="form-control form-control-sm mt-2" placeholder="Referencia (opcional)">
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Carrito -->
                    <div id="carritoItems"></div>

                    <hr />

                    <div class="d-flex justify-content-between small">
                        <span>Subtotal</span>
                        <span id="lblSubtotal">₡0.00</span>
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span>Impuesto (13%)</span>
                        <span id="lblImpuesto">₡0.00</span>
                    </div>
                    <div id="filaEnvio" class="d-flex justify-content-between small" style="display:none;">
                        <span>Costo de envío</span>
                        <span id="lblEnvio">₡0.00</span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold mt-1">
                        <span>Total</span>
                        <span id="lblTotal" style="color:#f5a623;">₡0.00</span>
                    </div>

                    <button type="button" id="btnConfirmarPedido" class="btn w-100 mt-3" disabled
                            style="background-color:#f5a623; color:#1a1a1a; font-weight:bold;">
                        Confirmar Pedido
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const catalogo = @Html.Raw(catalogoJson);
        const metodosPago = @Html.Raw(metodosPagoJson);
        const csrfToken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(csrfToken));
        const costoEnvioDomicilio = @costoEnvioDomicilio.ToString(System.Globalization.CultureInfo.InvariantCulture);

        // El carrito se guarda en localStorage (ver site.js) para que el contador
        // del navbar se mantenga sincronizado con esta vista.
        let carrito = obtenerCarritoStorage();
        let categoriaActiva = null; // null = todas

        // ---------- Móvil: pestañas Catálogo / Mi pedido ----------
        // En pantallas chicas no tiene sentido obligar a hacer scroll por todo el
        // catálogo antes de llegar al resumen del pedido: se navega con pestañas y,
        // dentro del catálogo, la grilla no se muestra hasta elegir una categoría
        // (o buscar algo). En desktop (≥992px, breakpoint lg de Bootstrap) esto no
        // aplica: se ve todo de una vez, como siempre.
        function esMovil() {
            return window.innerWidth < 992;
        }

        let tabActiva = 'catalogo'; // 'catalogo' | 'pedido'
        let catalogoRevelado = !esMovil();

        function aplicarLayoutMovil() {
            const colCatalogo = document.getElementById('colCatalogo');
            const colPedido = document.getElementById('colPedido');
            if (!colCatalogo || !colPedido) return;

            if (esMovil()) {
                colCatalogo.style.display = tabActiva === 'catalogo' ? '' : 'none';
                colPedido.style.display = tabActiva === 'pedido' ? '' : 'none';
            } else {
                colCatalogo.style.display = '';
                colPedido.style.display = '';
            }
        }

        function cambiarTabMovil(tab) {
            tabActiva = tab;
            document.getElementById('btnTabCatalogo').classList.toggle('active', tab === 'catalogo');
            document.getElementById('btnTabPedido').classList.toggle('active', tab === 'pedido');
            aplicarLayoutMovil();
        }

        document.getElementById('btnTabCatalogo').addEventListener('click', () => cambiarTabMovil('catalogo'));
        document.getElementById('btnTabPedido').addEventListener('click', () => cambiarTabMovil('pedido'));
        window.addEventListener('resize', aplicarLayoutMovil);

        function actualizarBadgeTabPedido() {
            const badge = document.getElementById('badgeTabPedido');
            if (!badge) return;
            badge.textContent = carrito.reduce((acc, i) => acc + i.cantidad, 0);
        }

        // ---------- Categorías ----------
        function renderCategorias() {
            const cont = document.getElementById('categoriasFiltro');
            if (!cont) return;

            const categorias = [...new Set(catalogo.map(i => i.categoria).filter(Boolean))].sort();
            const opciones = ['Todas', ...categorias];

            cont.innerHTML = opciones.map((cat, idx) => `
                <button type="button" class="btn-categoria" data-cat="${cat === 'Todas' ? '' : cat}" data-idx="${idx}"></button>
            `).join('');

            cont.querySelectorAll('.btn-categoria').forEach((btn, idx) => {
                btn.textContent = opciones[idx];
                if (!categoriaActiva && opciones[idx] === 'Todas') btn.classList.add('active');
                if (categoriaActiva && opciones[idx] === categoriaActiva) btn.classList.add('active');

                btn.addEventListener('click', () => {
                    categoriaActiva = btn.dataset.cat || null;
                    catalogoRevelado = true;
                    cont.querySelectorAll('.btn-categoria').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    renderCatalogo();
                });
            });
        }

        // ---------- Catálogo ----------
        function renderCatalogo() {
            const cont = document.getElementById('catalogoGrid');
            if (!cont) return;

            if (esMovil() && !catalogoRevelado) {
                cont.innerHTML = '<p class="text-muted text-center my-4">Elegí una categoría arriba (o buscá un producto) para ver el catálogo.</p>';
                return;
            }

            const inputBusqueda = document.getElementById('inputBuscarProducto');
            const term = (inputBusqueda?.value || '').toLowerCase();

            const indices = catalogo
                .map((item, idx) => idx)
                .filter(idx => {
                    const coincideTexto = catalogo[idx].nombre.toLowerCase().includes(term);
                    const coincideCategoria = !categoriaActiva || catalogo[idx].categoria === categoriaActiva;
                    return coincideTexto && coincideCategoria;
                });

            if (indices.length === 0) {
                cont.innerHTML = '<p class="text-muted text-center my-4">No se encontraron resultados.</p>';
                return;
            }

            cont.innerHTML = indices.map(idx => `
                <div class="col-6 col-md-4 col-xl-3">
                    <div class="card h-100 shadow-sm catalogo-card" style="cursor:pointer;" data-idx="${idx}">
                        ${catalogo[idx].imagen
                            ? `<img src="${catalogo[idx].imagen}" class="card-img-top" style="height:130px; object-fit:cover;" alt="">`
                            : '<div style="height:130px;" class="bg-light"></div>'}
                        <div class="card-body p-3 text-center">
                            <div class="fw-semibold nombre-item mb-1"></div>
                            <div style="color:#f5a623;">₡${catalogo[idx].precio.toFixed(2)}</div>
                        </div>
                    </div>
                </div>
            `).join('');

            cont.querySelectorAll('.catalogo-card').forEach(card => {
                const idx = parseInt(card.dataset.idx);
                card.querySelector('.nombre-item').textContent = catalogo[idx].nombre;
                card.addEventListener('click', () => agregarAlCarrito(catalogo[idx]));
            });
        }

        const inputBuscarProducto = document.getElementById('inputBuscarProducto');
        if (inputBuscarProducto) {
            inputBuscarProducto.addEventListener('input', function () {
                if (this.value.trim()) catalogoRevelado = true;
                renderCatalogo();
            });
        }

        // ---------- Carrito ----------
        function agregarAlCarrito(item) {
            const existente = carrito.find(i => i.tipo === item.tipo && i.id === item.id);
            if (existente) {
                existente.cantidad++;
            } else {
                carrito.push({ tipo: item.tipo, id: item.id, nombre: item.nombre, precio: item.precio, cantidad: 1, observaciones: '' });
            }
            renderCarrito();

            // En móvil "Mi pedido" queda oculto mientras se navega el catálogo:
            // este aviso confirma que se agregó sin tener que cambiar de pestaña.
            Swal.fire({
                icon: 'success',
                title: 'Agregado a tu pedido',
                text: item.nombre,
                toast: true,
                position: 'top-end',
                timer: 1200,
                showConfirmButton: false
            });

            const inputBusqueda = document.getElementById('inputBuscarProducto');
            if (inputBusqueda && inputBusqueda.value) {
                inputBusqueda.value = '';
                renderCatalogo();
            }
        }

        function cambiarCantidad(index, delta) {
            carrito[index].cantidad += delta;
            if (carrito[index].cantidad <= 0) carrito.splice(index, 1);
            renderCarrito();
        }

        function quitarDelCarrito(index) {
            carrito.splice(index, 1);
            renderCarrito();
        }

        function esDomicilio() {
            return document.getElementById('selectMetodoEntrega').value === 'Entrega a domicilio';
        }

        function calcularTotales() {
            let subtotal = 0;
            carrito.forEach((item, idx) => {
                const input = document.querySelector(`.input-cantidad[data-idx="${idx}"]`);
                const texto = input ? input.value.trim() : '';
                const cantidad = texto === '' ? item.cantidad : (parseInt(texto, 10) || 0);
                subtotal += item.precio * cantidad;
            });
            const impuesto = Math.round(subtotal * 0.13 * 100) / 100;
            const envio = esDomicilio() ? costoEnvioDomicilio : 0;
            const total = subtotal + impuesto + envio;
            return { subtotal, impuesto, envio, total };
        }

        function actualizarTotalesEnVivo() {
            const { subtotal, impuesto, envio, total } = calcularTotales();
            document.getElementById('lblSubtotal').textContent = `₡${subtotal.toFixed(2)}`;
            document.getElementById('lblImpuesto').textContent = `₡${impuesto.toFixed(2)}`;
            document.getElementById('filaEnvio').style.display = envio > 0 ? 'flex' : 'none';
            document.getElementById('lblEnvio').textContent = `₡${envio.toFixed(2)}`;
            document.getElementById('lblTotal').textContent = `₡${total.toFixed(2)}`;
            document.getElementById('btnConfirmarPedido').disabled = carrito.length === 0;

            guardarCarritoStorage(carrito);
        }

        function actualizarLineaVisual(idx, cantidadTexto) {
            const fila = document.querySelector(`[data-fila="${idx}"]`);
            if (!fila) return;
            const cantidad = cantidadTexto !== undefined
                ? (cantidadTexto === '' ? carrito[idx].cantidad : (parseInt(cantidadTexto, 10) || 0))
                : carrito[idx].cantidad;
            const subtotalLinea = carrito[idx].precio * cantidad;
            const impuestoLinea = Math.round(subtotalLinea * 0.13 * 100) / 100;
            fila.querySelector('.lbl-subtotal-linea').textContent = `₡${subtotalLinea.toFixed(2)}`;
            fila.querySelector('.lbl-impuesto-linea').textContent = `₡${impuestoLinea.toFixed(2)}`;
        }

        function renderCarrito() {
            const cont = document.getElementById('carritoItems');
            actualizarBadgeTabPedido();

            if (carrito.length === 0) {
                cont.innerHTML = '<p class="text-muted text-center my-3 small">El carrito está vacío.</p>';
            } else {
                cont.innerHTML = carrito.map((item, idx) => `
                    <div class="border-bottom py-2" data-fila="${idx}">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold nombre-carrito"></div>
                                <div class="small text-muted">₡${item.precio.toFixed(2)} c/u</div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <button type="button" class="btn btn-touch btn-outline-secondary" onclick="cambiarCantidad(${idx}, -1)">-</button>
                                <input type="text" inputmode="numeric" class="form-control form-control-sm text-center input-cantidad"
                                       style="width:52px;" value="${item.cantidad}" data-idx="${idx}">
                                <button type="button" class="btn btn-touch btn-outline-secondary" onclick="cambiarCantidad(${idx}, 1)">+</button>
                                <button type="button" class="btn btn-touch btn-outline-danger" onclick="quitarDelCarrito(${idx})">×</button>
                            </div>
                        </div>
                        <input type="text" class="form-control form-control-sm mt-1 input-observaciones" data-idx="${idx}"
                               placeholder="Observaciones (opcional)">
                        <div class="d-flex justify-content-between small text-muted mt-1">
                            <span>Subtotal: <span class="lbl-subtotal-linea"></span></span>
                            <span>Impuesto: <span class="lbl-impuesto-linea"></span></span>
                        </div>
                    </div>
                `).join('');

                cont.querySelectorAll('[data-fila]').forEach((fila, idx) => {
                    fila.querySelector('.nombre-carrito').textContent = carrito[idx].nombre;
                    fila.querySelector('.input-observaciones').value = carrito[idx].observaciones || '';
                    actualizarLineaVisual(idx);
                });

                cont.querySelectorAll('.input-cantidad').forEach(input => {
                    input.addEventListener('input', function () {
                        this.value = this.value.replace(/[^0-9]/g, '');
                        const idx = parseInt(this.dataset.idx);
                        actualizarLineaVisual(idx, this.value);
                        actualizarTotalesEnVivo();
                    });
                    input.addEventListener('blur', function () {
                        const idx = parseInt(this.dataset.idx);
                        const val = this.value.trim();
                        if (val === '') {
                            // Casilla vacía: se restaura la cantidad anterior, NO se borra la línea.
                            this.value = carrito[idx].cantidad;
                            actualizarLineaVisual(idx);
                            actualizarTotalesEnVivo();
                            return;
                        }
                        const cantidad = parseInt(val, 10);
                        if (cantidad === 0) {
                            quitarDelCarrito(idx);
                        } else {
                            carrito[idx].cantidad = cantidad;
                            renderCarrito();
                        }
                    });
                });

                cont.querySelectorAll('.input-observaciones').forEach(input => {
                    input.addEventListener('input', function () {
                        carrito[parseInt(this.dataset.idx)].observaciones = this.value;
                        guardarCarritoStorage(carrito);
                    });
                });
            }

            actualizarTotalesEnVivo();
        }

        // ---------- Método de entrega ----------
        document.getElementById('selectMetodoEntrega').addEventListener('change', function () {
            document.getElementById('panelDireccion').style.display = esDomicilio() ? 'block' : 'none';
            actualizarTotalesEnVivo();
        });

        // ---------- Confirmar pedido ----------
        document.getElementById('btnConfirmarPedido').addEventListener('click', function () {
            if (esDomicilio() && !document.getElementById('inputDireccionExacta').value.trim()) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Falta la dirección',
                    text: 'Indique la dirección exacta de entrega.',
                    confirmButtonColor: '#f5a623'
                });
                return;
            }

            const { total } = calcularTotales();

            Swal.fire({
                title: 'Confirmar pedido',
                html: `
                    <div class="text-start">
                        <p class="h4 text-center" style="color:#f5a623;">₡${total.toFixed(2)}</p>
                        <label class="form-label small">Método de pago</label>
                        <select id="swalMetodoPago" class="form-select mb-2">
                            ${metodosPago.map(m => `<option value="${m.id}" data-nombre="${m.nombre}">${m.nombre}</option>`).join('')}
                        </select>
                        <div id="swalPanelTarjeta" style="display:none;">
                            <label class="form-label small">Tipo de tarjeta</label>
                            <select id="swalTipoTarjeta" class="form-select mb-2">
                                <option value="Crédito">Crédito</option>
                                <option value="Débito">Débito</option>
                            </select>
                            <label class="form-label small">Nombre en la tarjeta</label>
                            <input type="text" id="swalNombreTarjeta" class="form-control mb-2" placeholder="Como aparece en la tarjeta">
                            <label class="form-label small">Últimos 4 dígitos</label>
                            <input type="text" id="swalUltimosDigitos" class="form-control mb-2" maxlength="4" inputmode="numeric" placeholder="0000">
                        </div>
                        <div id="swalPanelEfectivo" style="display:none;" class="alert alert-light border small mb-0">
                            Pagará en efectivo cuando retire o reciba su pedido.
                        </div>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'Confirmar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#f5a623',
                cancelButtonColor: '#6c757d',
                didOpen: () => {
                    const selectMetodo = document.getElementById('swalMetodoPago');
                    const panelTarjeta = document.getElementById('swalPanelTarjeta');
                    const panelEfectivo = document.getElementById('swalPanelEfectivo');

                    const actualizarPaneles = () => {
                        const nombre = (selectMetodo.selectedOptions[0].dataset.nombre || '').toLowerCase();
                        const esPagoWeb = nombre.includes('web');
                        panelTarjeta.style.display = esPagoWeb ? 'block' : 'none';
                        panelEfectivo.style.display = esPagoWeb ? 'none' : 'block';
                    };
                    selectMetodo.addEventListener('change', actualizarPaneles);
                    actualizarPaneles();
                },
                preConfirm: () => {
                    const selectMetodo = document.getElementById('swalMetodoPago');
                    const idMetodoPago = parseInt(selectMetodo.value);
                    const nombre = selectMetodo.selectedOptions[0].dataset.nombre.toLowerCase();
                    let tipoTarjeta = null, ultimosDigitos = null;

                    if (nombre.includes('web')) {
                        const nombreTarjeta = document.getElementById('swalNombreTarjeta').value.trim();
                        if (!nombreTarjeta) {
                            Swal.showValidationMessage('Ingrese el nombre en la tarjeta.');
                            return false;
                        }
                        tipoTarjeta = document.getElementById('swalTipoTarjeta').value;
                        ultimosDigitos = document.getElementById('swalUltimosDigitos').value.trim();
                        if (ultimosDigitos.length !== 4 || isNaN(ultimosDigitos)) {
                            Swal.showValidationMessage('Ingrese los últimos 4 dígitos de la tarjeta.');
                            return false;
                        }
                    }

                    return { idMetodoPago, tipoTarjeta, ultimosDigitos };
                }
            }).then(result => {
                if (result.isConfirmed) {
                    registrarPedido(result.value);
                }
            });
        });

        async function registrarPedido({ idMetodoPago, tipoTarjeta, ultimosDigitos }) {
            const dto = {
                metodoEntrega: document.getElementById('selectMetodoEntrega').value,
                provincia: esDomicilio() ? document.getElementById('inputProvincia').value : null,
                canton: esDomicilio() ? document.getElementById('inputCanton').value : null,
                distrito: esDomicilio() ? document.getElementById('inputDistrito').value : null,
                direccionExacta: esDomicilio() ? document.getElementById('inputDireccionExacta').value : null,
                referencia: esDomicilio() ? document.getElementById('inputReferencia').value : null,
                idMetodoPago: idMetodoPago,
                tipoTarjeta: tipoTarjeta,
                ultimosDigitos: ultimosDigitos,
                items: carrito.map(i => ({ tipo: i.tipo, id: i.id, cantidad: i.cantidad, observaciones: i.observaciones || null }))
            };

            try {
                const res = await fetch('/Carrito/Comprar', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': csrfToken
                    },
                    body: JSON.stringify(dto)
                });
                const data = await res.json();

                if (data.exito) {
                    const r = data.resultado;

                    // El pedido ya se registró: se vacía el carrito local y el badge.
                    carrito = [];
                    guardarCarritoStorage(carrito);

                    await Swal.fire({
                        icon: 'success',
                        title: '¡Pedido enviado!',
                        html: `
                            <p class="mb-1">Orden: <strong>${r.codigoOrden}</strong></p>
                            <p class="mb-1">Total: ₡${r.total.toFixed(2)}</p>
                            <p class="mb-0 text-muted small">Puede seguir su estado en "Mis Pedidos".</p>
                        `,
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#f5a623'
                    });
                    window.location.href = '/Pedido/Index';
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'No se pudo registrar el pedido',
                        text: data.mensaje,
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#2d0000'
                    });
                }
            } catch (e) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error de conexión',
                    text: 'No se pudo comunicar con el servidor.',
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#2d0000'
                });
            }
        }

        // Inicialización
        aplicarLayoutMovil();
        renderCategorias();
        renderCatalogo();
        renderCarrito();
    </script>
}
