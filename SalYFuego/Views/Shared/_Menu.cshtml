@using Sal_Fuego.Aplication.Config

@{
    bool autenticado = User.Identity?.IsAuthenticated == true;
    bool esAdmin = User.IsInRole(Roles.Administrador);
    bool esOperativo = User.IsInRole(Roles.Encargado) || User.IsInRole(Roles.Cocina)
        || User.IsInRole(Roles.Salonero) || User.IsInRole(Roles.Repartidor);
    // El catálogo (productos, combos, menús) se muestra a público y Cliente.
    // Administrador ve directamente los mantenimientos en vez del catálogo público.
    // Los roles operativos (Caja, Cocina, Salón, Repartidor) solo ven su propio panel.
    bool mostrarCatalogo = !esOperativo && !esAdmin;
}

<nav class="navbar navbar-expand-lg shadow-sm"
     style="background-color: #ffffff; border-bottom: 3px solid #f5a623;">
    <div class="container">
        <!-- Logo -->
        <a class="navbar-brand d-flex align-items-center gap-2"
           asp-controller="Home" asp-action="Index">
            <img src="/uploads/productos/salyfuego-logo.jpg"
                 alt="Sal y Fuego"
                 style="height: 45px; width: auto; border-radius: 6px;">
        </a>

        <!-- Botón hamburguesa móvil -->
        <button class="navbar-toggler border-0" type="button"
                data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"
                  style="filter: invert(1);"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <!-- Links principales -->
            <ul class="navbar-nav me-auto gap-1">
                @if (!esOperativo)
                {
                    <!-- Para los roles operativos (Caja, Cocina, Salón, Repartidor), "Inicio"
                         redirige a su propio panel, que ya tiene su link específico más abajo:
                         mostrar ambos sería un enlace duplicado a la misma pantalla.
                         Administrador sí lo conserva: es su único acceso directo al panel. -->
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded"
                           style="color: #333; letter-spacing:1px; font-size:0.85rem;"
                           asp-controller="Home" asp-action="Index">
                            INICIO
                        </a>
                    </li>
                }

                @if (mostrarCatalogo)
                {
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded"
                           style="color: #333; letter-spacing:1px; font-size:0.85rem;"
                           asp-controller="Producto" asp-action="Index">
                            PRODUCTOS
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded"
                           style="color: #333; letter-spacing:1px; font-size:0.85rem;"
                           asp-controller="Combo" asp-action="Index">
                            COMBOS
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded"
                           style="color: #333; letter-spacing:1px; font-size:0.85rem;"
                           asp-controller="Menu" asp-action="Index">
                            MENÚS
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded"
                           style="color: #333; letter-spacing:1px; font-size:0.85rem;"
                           asp-controller="Menu" asp-action="Disponible">
                            MENÚ DEL DÍA
                        </a>
                    </li>
                }
                @if (User.IsInRole(Roles.Cliente))
                {
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded"
                           style="color: #333; letter-spacing:1px; font-size:0.85rem;"
                           asp-controller="Pedido" asp-action="Index">
                            MIS PEDIDOS
                        </a>
                    </li>
                }

                @if (esAdmin)
                {
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded"
                           style="color: #333; letter-spacing:1px; font-size:0.85rem;"
                           asp-controller="AdminProducto" asp-action="Index">
                            PRODUCTOS
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded"
                           style="color: #333; letter-spacing:1px; font-size:0.85rem;"
                           asp-controller="AdminCombo" asp-action="Index">
                            COMBOS
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded"
                           style="color: #333; letter-spacing:1px; font-size:0.85rem;"
                           asp-controller="AdminMenu" asp-action="Index">
                            MENÚS
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded"
                           style="color: #333; letter-spacing:1px; font-size:0.85rem;"
                           asp-controller="AdminProceso" asp-action="Index">
                            PROCESOS
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded"
                           style="color: #333; letter-spacing:1px; font-size:0.85rem;"
                           asp-controller="Ingrediente" asp-action="Index">
                            INGREDIENTES
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded"
                           style="color: #333; letter-spacing:1px; font-size:0.85rem;"
                           asp-controller="AdminUsuario" asp-action="Index">
                            USUARIOS
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded"
                           style="color: #333; letter-spacing:1px; font-size:0.85rem;"
                           asp-controller="Pedido" asp-action="Index">
                            PEDIDOS
                        </a>
                    </li>
                }
                @if (User.IsInRole(Roles.Encargado))
                {
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded"
                           style="color: #333; letter-spacing:1px; font-size:0.85rem;"
                           asp-controller="Caja" asp-action="Index">
                            CAJA
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded"
                           style="color: #333; letter-spacing:1px; font-size:0.85rem;"
                           asp-controller="Pedido" asp-action="Index">
                            PEDIDOS
                        </a>
                    </li>
                }
                @if (User.IsInRole(Roles.Cocina))
                {
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded"
                           style="color: #333; letter-spacing:1px; font-size:0.85rem;"
                           asp-controller="Cocina" asp-action="Index">
                            COCINA
                        </a>
                    </li>
                }
                @if (User.IsInRole(Roles.Salonero))
                {
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded"
                           style="color: #333; letter-spacing:1px; font-size:0.85rem;"
                           asp-controller="Salonero" asp-action="Index">
                            SALÓN
                        </a>
                    </li>
                }
                @if (User.IsInRole(Roles.Repartidor))
                {
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded"
                           style="color: #333; letter-spacing:1px; font-size:0.85rem;"
                           asp-controller="Repartidor" asp-action="Index">
                            MIS ENTREGAS
                        </a>
                    </li>
                }
            </ul>

            <!-- Lado derecho: Carrito + Sesión -->
            <ul class="navbar-nav ms-auto align-items-center gap-3">

                @if (User.IsInRole(Roles.Cliente))
                {
                    <!-- Carrito: solo el Cliente logueado puede comprar -->
                    <li class="nav-item">
                        <a class="nav-link position-relative px-2"
                           style="color: #333;"
                           asp-controller="Carrito" asp-action="Index">
                            CARRITO
                            <span id="badgeCarrito"
                                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill"
                                  style="background-color: #f5a623; color: #1a1a1a; font-size: 0.65rem; display:none;">
                                0
                            </span>
                        </a>
                    </li>
                }
                else if (mostrarCatalogo)
                {
                    <!-- Público no autenticado: solo un indicador, debe iniciar sesión para comprar -->
                    <li class="nav-item">
                        <a class="nav-link position-relative px-2"
                           asp-controller="Login" asp-action="Index" style="color: #333;">
                            CARRITO
                        </a>
                    </li>
                }

                @if (autenticado)
                {
                    <li class="nav-item">
                        <span class="small" style="color:#333;">
                            Hola, @User.Identity!.Name
                        </span>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Login" asp-action="LogOff"
                           class="btn btn-sm btn-outline-dark px-3"
                           style="font-size: 0.8rem; letter-spacing: 1px;">
                            CERRAR SESIÓN
                        </a>
                    </li>
                }
                else
                {
                    <!-- Iniciar Sesión -->
                    <li class="nav-item">
                        <a asp-controller="Login" asp-action="Index"
                           class="btn btn-sm btn-outline-dark px-3"
                           style="font-size: 0.8rem; letter-spacing: 1px;">
                            INICIAR SESIÓN
                        </a>
                    </li>

                    <!-- Registrarse -->
                    <li class="nav-item">
                        <a asp-controller="Login" asp-action="Registro"
                           class="btn btn-sm px-3"
                           style="background-color: #f5a623;
                            color: #1a1a1a;
                            font-weight: bold;
                            font-size: 0.8rem;
                            letter-spacing: 1px;">
                            REGISTRARSE
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
