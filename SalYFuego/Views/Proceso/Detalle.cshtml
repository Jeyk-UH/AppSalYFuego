@model Sal_Fuego.Aplication.DTOs.ProcesoDTO

@{
    ViewData["Title"] = "Proceso de Preparación";
}

<div class="container mt-4">
    <a asp-controller="Proceso" asp-action="Index"
       class="btn btn-secondary mb-3">
        ← Volver
    </a>

    <h2>@Model.NombreProducto</h2>
    <p class="text-muted">
        Total de pasos:
        <span class="badge bg-primary">@Model.CantidadPasos</span>
    </p>
    <hr />

    <h5>Estaciones de preparación:</h5>
    <div class="list-group">
        @foreach (var paso in Model.Pasos)
        {
            <div class="list-group-item d-flex align-items-center gap-3">
                <span class="badge bg-warning text-dark fs-6">
                    Paso @paso.OrdenPaso
                </span>
                <div>
                    <strong>@paso.NombreEstacion</strong>
                    <br />
                    <small class="text-muted">
                        Tiempo estimado: @paso.TiempoEstimadoMinutos minutos
                    </small>
                </div>
            </div>
        }
    </div>
</div>